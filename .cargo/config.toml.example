# Необязательно. Если проект лежит в OneDrive (или другой синхронизируемой папке),
# вынесите папку сборки Rust наружу: target/ весит гигабайты, и синхронизация
# тормозит сборку, а иногда блокирует файлы ("Access is denied").
#
# Скопируйте этот файл в .cargo/config.toml и укажите свой путь.
[build]
target-dir = "C:/dev/cargo-targets/liquid-player"
